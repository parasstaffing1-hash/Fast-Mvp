# ==============================================================================
# Picked AI Visibility Scanner - Environment Variables Configuration
# ==============================================================================

# Application URL
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 1. SUPABASE / POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL: Project URL from Supabase dashboard (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=""

# NEXT_PUBLIC_SUPABASE_ANON_KEY: Public anonymous API key
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# SUPABASE_SERVICE_ROLE_KEY: Secret service-role key (server-side only, never exposed to client)
SUPABASE_SERVICE_ROLE_KEY=""

# ------------------------------------------------------------------------------
# 2. OPENAI (CHATGPT) INTEGRATION
# ------------------------------------------------------------------------------
# OPENAI_API_KEY: Secret API key from OpenAI Platform (sk-proj-...)
OPENAI_API_KEY=""

# OPENAI_MODEL: Model to evaluate (default: gpt-4o-mini)
OPENAI_MODEL="gpt-4o-mini"

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI AI INTEGRATION
# ------------------------------------------------------------------------------
# GEMINI_API_KEY or GOOGLE_GENERATIVE_AI_API_KEY:
# Automatically provisioned in Google AI Studio or provide key from Google AI Studio.
GEMINI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""

# GEMINI_MODEL: Model to query (default: gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# ------------------------------------------------------------------------------
# 4. EMAIL DELIVERY (RESEND)
# ------------------------------------------------------------------------------
# RESEND_API_KEY: API Key from Resend (re_...)
RESEND_API_KEY=""

# EMAIL_FROM: Verified sender address (default: onboarding@resend.dev during testing)
EMAIL_FROM="Picked AI Scanner <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# 5. BACKGROUND JOBS (TRIGGER.DEV)
# ------------------------------------------------------------------------------
# TRIGGER_SECRET_KEY: Secret key from Trigger.dev project settings (tr_dev_... or tr_prod_...)
TRIGGER_SECRET_KEY=""

# ------------------------------------------------------------------------------
# 6. LEGITIMATE GOOGLE SEARCH VISIBILITY (OPTIONAL)
# ------------------------------------------------------------------------------
# GOOGLE_SEARCH_API_KEY: Official Google Custom Search JSON API Key
# Note: Google Search visibility is strictly separated from LLM AI Overview answers.
GOOGLE_SEARCH_API_KEY=""
GOOGLE_CUSTOM_SEARCH_CX=""

# ------------------------------------------------------------------------------
# 7. DEVELOPMENT & DEMO TESTING
# ------------------------------------------------------------------------------
# DEMO_MODE: Set to "true" to test the scanner with mock provider outputs without spending API credits.
# Safety rule: Demo mode is strictly disabled in standard production.
DEMO_MODE="false"
